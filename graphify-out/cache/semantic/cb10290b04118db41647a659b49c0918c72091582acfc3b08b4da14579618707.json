{"nodes": [{"id": "design_el_mostrador", "label": "Creative North Star: El Mostrador", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A counter, not a dashboard: catalog grid left, fixed ticket right, charge button shows the amount; everything else supports the sell gesture. Rejected stacked-button line form (old POS), shortcut chips inside buttons, and branded teal accent resembling a competitor."}, {"id": "design_one_accent_rule", "label": "The One Accent Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors / Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single accent per install means action or selection only; components request it via var(--accent) so the business color reaches everything."}, {"id": "design_own_color_rule", "label": "The Own Color Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors / Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business picks the hue, system guarantees legibility by darkening/lightening in 6% steps until 4.5:1 contrast."}, {"id": "design_temaconacento", "label": "temaConAcento()", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "The Own Color Rule", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_color_acento_config", "label": "Config color_acento (business accent color)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Colors / Primary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_two_lines_rule", "label": "The Two Lines Rule (line vs hair)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors / Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "line (>=3:1) bounds controls, hair only separates; a control border never uses hair."}, {"id": "design_tested_pair_rule", "label": "The Tested Pair Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors / Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every new color goes into TEMAS in both themes and combinaciones() with its minimum; test also runs with eight sample business colors. If the test does not cover it, it is not used."}, {"id": "design_tabular_money_rule", "label": "The Tabular Money Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Typography", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All money and quantities use tabular-nums, right aligned, colon sign attached, dot thousands, no decimals."}, {"id": "design_no_caps_rule", "label": "The No Caps Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Typography", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_fixed_ticket_rule", "label": "The Fixed Ticket Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ticket never scrolls with catalog; only its lines scroll; Cobrar always visible."}, {"id": "design_flat_until_hover_rule", "label": "The Flat-Until-Hover Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Elevation & Depth", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_boton_cobrar", "label": "Boton Cobrar (signature charge button)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components / Buttons", "source_url": null, "captured_at": null, "author": null, "contributor": nu